local function findAllInteractables(model)
    local interactables = {
        proximityPrompts = {},
        clickDetectors = {}
    }
    
    for _, descendant in pairs(model:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            table.insert(interactables.proximityPrompts, descendant)
        elseif descendant:IsA("ClickDetector") then
            table.insert(interactables.clickDetectors, descendant)
        end
    end
    
    return interactables
end

local function triggerInteractables(model)
    local interactables = findAllInteractables(model)
    
    for _, prompt in pairs(interactables.proximityPrompts) do
        pcall(function()
            local oldHold = prompt.HoldDuration
            local oldEnabled = prompt.Enabled
            local oldDistance = prompt.MaxActivationDistance
            
            prompt.HoldDuration = 0
            prompt.Enabled = true
            prompt.MaxActivationDistance = 9999
            
            for i = 1, 5 do
                prompt:InputHoldBegin()
                fireSignal(prompt.PromptButtonHoldBegan)
                task.wait(0.05)
                prompt:InputHoldEnd()
                fireSignal(prompt.PromptButtonHoldEnded)
                fireSignal(prompt.Triggered)
                task.wait(0.05)
            end
            
            prompt.HoldDuration = oldHold
            prompt.Enabled = oldEnabled
            prompt.MaxActivationDistance = oldDistance
        end)
    end
    
    for _, detector in pairs(interactables.clickDetectors) do
        pcall(function()
            local oldDistance = detector.MaxActivationDistance
            detector.MaxActivationDistance = 9999
            
            for i = 1, 5 do
                fireclickdetector(detector)
                task.wait(0.05)
            end
            
            detector.MaxActivationDistance = oldDistance
        end)
    end
end

local function isStuck(rootPart, lastPosition, stuckTime)
    if not lastPosition then return false end
    
    local currentPos = rootPart.Position
    local distance = (currentPos - lastPosition).Magnitude
    
    return distance < 2 and (tick() - stuckTime) > 2
end

local function unstuck(rootPart)
    local humanoid = getHumanoid()
    if not humanoid then return end
    
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.3)
    
    local currentPos = rootPart.Position
    local unstuckPos = currentPos + Vector3.new(
        math.random(-15, 15),
        2,
        math.random(-15, 15)
    )
    
    humanoid:MoveTo(unstuckPos)
    task.wait(0.8)
    
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.3)
end

local function moveToPosition(position, timeout)
    local humanoid = getHumanoid()
    local rootPart = getRootPart()
    if not humanoid or not rootPart then return false end
    
    timeout = timeout or 15
    local startTime = tick()
    local lastPos = rootPart.Position
    local stuckCheckTime = tick()
    local jumpTimer = tick()
    
    humanoid:MoveTo(position)
    lastMovementTime = tick()
    
    while tick() - startTime < timeout do
        task.wait(0.1)
        
        rootPart = getRootPart()
        humanoid = getHumanoid()
        if not rootPart or not humanoid then return false end
        
        if tick() - jumpTimer > 1.5 then
            if math.random(1, 3) == 1 then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            jumpTimer = tick()
        end
        
        if isStuck(rootPart, lastPos, stuckCheckTime) then
            unstuck(rootPart)
            lastPos = rootPart.Position
            stuckCheckTime = tick()
            humanoid:MoveTo(position)
        end
        
        local distance = (rootPart.Position - position).Magnitude
        if distance < 5 then
            return true
        end
        
        lastPos = rootPart.Position
    end
    
    return false
end

