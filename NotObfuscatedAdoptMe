                                    local shouldBeVisible = inventorySettings.neon
                                    if neon.Visible ~= shouldBeVisible then
                                        neon.Visible = shouldBeVisible
                                        changedCount = changedCount + 1
                                    end
                                    if shouldBeVisible and mega_neon and mega_neon.Visible then
                                        mega_neon.Visible = false
                                    end
                                end
                                
                                if rideable then
                                    local shouldBeVisible = inventorySettings.rideable
                                    if rideable.Visible ~= shouldBeVisible then
                                        rideable.Visible = shouldBeVisible
                                        changedCount = changedCount + 1
                                    end
                                end
                                
                                if flyable then
                                    local shouldBeVisible = inventorySettings.flyable
                                    if flyable.Visible ~= shouldBeVisible then
                                        flyable.Visible = shouldBeVisible
                                        changedCount = changedCount + 1
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
