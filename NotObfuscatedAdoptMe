                if config then
                    statusLabel.Text = "Detected: " .. config.name
                    statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
                    statusIndicator.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
                    
