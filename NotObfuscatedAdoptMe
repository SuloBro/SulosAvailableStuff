        local function updateNumber(change)
            local current = hotbarSettings[settingKey]
            local new = current + change
            
            if new < 1 then new = 9 end
            if new > 9 then new = 1 end
            
            local conflicts = false
            for key, value in pairs(hotbarSettings) do
                if key ~= settingKey and key ~= "maxRetries" and value == new then
                    conflicts = true
                    break
                end
            end
            
            if conflicts then
                showNotification("Number " .. new .. " is already in use!")
                return
            end
            
            hotbarSettings[settingKey] = new
            numberLabel.Text = tostring(new)
            playSound(6895079853, 0.5)
        end
        
