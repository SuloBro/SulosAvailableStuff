                            if itemImageTemplate and inventorySettings.changeImage then
                                if itemImageTemplate.Image ~= inventorySettings.targetImage then
                                    itemImageTemplate.Image = inventorySettings.targetImage
                                    changedCount = changedCount + 1
                                end
                            end
                            
                            local tagDisplayTemplate = button:FindFirstChild("TagDisplayTemplate")
                            if tagDisplayTemplate then
                                local mega_neon = tagDisplayTemplate:FindFirstChild("mega_neon")
                                local neon = tagDisplayTemplate:FindFirstChild("neon")
                                local rideable = tagDisplayTemplate:FindFirstChild("rideable")
                                local flyable = tagDisplayTemplate:FindFirstChild("flyable")
                                
                                if mega_neon then
