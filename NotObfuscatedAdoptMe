local function getProgressGradient(taskId)
    local success, gradient = pcall(function()
        local ailmentsApp = playerGui:FindFirstChild("AilmentsMonitorApp")
        if not ailmentsApp then return nil end
        
        local main = ailmentsApp:FindFirstChild("Main")
        if not main then return nil end
        
        local ailments = main:FindFirstChild("Ailments")
        if not ailments then return nil end
        
        for _, container in pairs(ailments:GetChildren()) do
            if container.Name == "AilmentContainer" and container:IsA("Frame") then
                local ailment = container:FindFirstChild("Ailment")
                if ailment and ailment:IsA("ImageButton") then
                    local background = ailment:FindFirstChild("Background")
                    if background then
                        local icon = background:FindFirstChild("Icon")
                        if icon and icon:IsA("ImageLabel") and icon.Image == taskId then
                            local color = background:FindFirstChild("Color")
                            if color then
                                local circularProgressBar = color:FindFirstChild("CircularProgressBar")
                                if circularProgressBar then
                                    local right = circularProgressBar:FindFirstChild("Right")
                                    if right then
                                        local frame1 = right:FindFirstChild("Frame")
                                        if frame1 then
                                            local frame2 = frame1:FindFirstChild("Frame")
                                            if frame2 then
                                                local uiGradient = frame2:FindFirstChild("UIGradient")
                                                if uiGradient then
                                                    return uiGradient
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        
        return nil
    end)
    
    return success and gradient or nil
end

local function taskStillExists(taskId)
    for attempt = 1, 3 do
        local gradient = getProgressGradient(taskId)
        if gradient ~= nil then
            return true
        end
        if attempt < 3 then
            task.wait(0.3)
        end
    end
    return false
end

local function isProgressBeingMade(taskId, checkDuration)
    local gradient = getProgressGradient(taskId)
    if not gradient then return false end
    
    local initialRotation = gradient.Rotation
    task.wait(checkDuration or 1)
    
    gradient = getProgressGradient(taskId)
    if not gradient then return false end
    
    local finalRotation = gradient.Rotation
    
    return math.abs(finalRotation - initialRotation) > 2
end

local function getAllCurrentTasks()
    local tasks = {}
    
    for retry = 1, 5 do
        local success = pcall(function()
            local ailmentsApp = playerGui:FindFirstChild("AilmentsMonitorApp")
            if not ailmentsApp then 
                task.wait(0.5)
                return 
            end
            
            local main = ailmentsApp:FindFirstChild("Main")
            if not main then 
                task.wait(0.3)
                return 
            end
            
            local ailments = main:FindFirstChild("Ailments")
            if not ailments then 
                task.wait(0.3)
                return 
            end
            
            for _, container in pairs(ailments:GetChildren()) do
                if container.Name == "AilmentContainer" and container:IsA("Frame") then
                    local ailment = container:FindFirstChild("Ailment")
                    if ailment and ailment:IsA("ImageButton") then
                        local background = ailment:FindFirstChild("Background")
                        if background then
                            local icon = background:FindFirstChild("Icon")
                            if icon and icon:IsA("ImageLabel") then
                                local imageId = icon.Image
                                if taskConfigs[imageId] and enabledTasks[imageId] then
                                    table.insert(tasks, imageId)
                                end
                            end
                        end
                    end
                end
            end
        end)
        
        if success and #tasks > 0 then
            lastSuccessfulQueueUpdate = tick()
            break
        end
        
        if retry < 5 then
            task.wait(0.5)
        end
    end
    
    return tasks
end

local function resetSystemState()
    isProcessing = false
    currentTask = nil
    taskQueue = {}
    queueOrder = {}
    taskRetryCount = {}
    taskFailCount = {}
    deprioritizedTasks = {}
    lastTaskDetectionTime = tick()
    lastSuccessfulQueueUpdate = tick()
end

local function updateTaskQueue()
    local currentTasks = getAllCurrentTasks()
    
    if #currentTasks > 0 then
        lastTaskDetectionTime = tick()
    end
    
    for _, taskId in pairs(currentTasks) do
        if not taskQueue[taskId] then
            taskQueue[taskId] = tick()
            table.insert(queueOrder, taskId)
            if not taskRetryCount[taskId] then
                taskRetryCount[taskId] = 0
            end
            if not taskFailCount[taskId] then
                taskFailCount[taskId] = 0
            end
        end
    end
    
    local validQueue = {}
    for _, taskId in pairs(queueOrder) do
        local stillExists = false
        for _, currentTaskId in pairs(currentTasks) do
            if currentTaskId == taskId then
                stillExists = true
                break
            end
        end
        
        if stillExists then
            table.insert(validQueue, taskId)
        else
            taskQueue[taskId] = nil
            taskRetryCount[taskId] = 0
            taskFailCount[taskId] = 0
            deprioritizedTasks[taskId] = nil
        end
    end
    
    if hasPremium() then
        table.sort(validQueue, function(a, b)
            local aPrio = (taskConfigs[a].priority or 99)
            local bPrio = (taskConfigs[b].priority or 99)
            
            if deprioritizedTasks[a] and not deprioritizedTasks[b] then
                return false
            elseif not deprioritizedTasks[a] and deprioritizedTasks[b] then
                return true
            end
            
            return aPrio < bPrio
        end)
    end
    
    queueOrder = validQueue
end

local function getNextTask()
    updateTaskQueue()
    
    if #queueOrder > 0 then
        return queueOrder[1]
    end
    
    return nil
end

local function removeTaskFromQueue(taskId)
    taskQueue[taskId] = nil
    
    local newQueue = {}
    for _, id in pairs(queueOrder) do
        if id ~= taskId then
            table.insert(newQueue, id)
        end
    end
    queueOrder = newQueue
end

local function executeTask(taskId)
    local config = taskConfigs[taskId]
    if not config then return false end
    
    if config.action == "interact" then
        local model = findModelByNames(config.models)
        if not model then return false end
        if not taskStillExists(taskId) then return true end
        
        local targetPos = model:GetPivot().Position
        
        if moveToPosition(targetPos, 15) then
            task.wait(0.5)
            
            local attempts = 0
            local maxAttempts = hotbarSettings.maxRetries * 4
            
            while attempts < maxAttempts do
                if not taskStillExists(taskId) then
                    return true
                end
                
                triggerInteractables(model)
                fireKey(Enum.KeyCode.E)
                
                task.wait(1)
                
                if not taskStillExists(taskId) then
                    return true
                end
                
                if isProgressBeingMade(taskId, 1) then
                    return true
                end
                
                attempts = attempts + 1
                task.wait(0.3)
            end
            
            return false
        end
        
        return false
        
    elseif config.action == "piano" then
        local model = findModelByNames(config.models)
        if not model then return false end
        if not taskStillExists(taskId) then return true end
        
        local targetPos = model:GetPivot().Position
        
        if moveToPosition(targetPos, 15) then
            task.wait(0.5)
            
            local pianoRetries = 0
            local maxPianoRetries = hotbarSettings.maxRetries
            
            while pianoRetries < maxPianoRetries do
                if not taskStillExists(taskId) then
                    return true
                end
                
                local interactionAttempts = 0
                local maxInteractionAttempts = 5
                local progressDetected = false
                
                while interactionAttempts < maxInteractionAttempts do
                    if not taskStillExists(taskId) then
                        return true
                    end
                    
                    triggerInteractables(model)
                    fireKey(Enum.KeyCode.E)
                    task.wait(0.3)
                    
                    if not taskStillExists(taskId) then
                        return true
                    end
                    
                    fireKey(Enum.KeyCode.Two)
                    task.wait(0.5)
                    
                    if not taskStillExists(taskId) then
                        return true
                    end
                    
                    local checkStartTime = tick()
                    local rotationCheckDuration = 5
                    local initialGradient = getProgressGradient(taskId)
                    
                    if initialGradient then
                        local initialRotation = initialGradient.Rotation
                        
                        local elapsed = 0
                        while elapsed < rotationCheckDuration do
                            task.wait(0.5)
                            elapsed = elapsed + 0.5
                            
                            if not taskStillExists(taskId) then
                                return true
                            end
                        end
                        
                        local finalGradient = getProgressGradient(taskId)
                        if finalGradient then
                            local finalRotation = finalGradient.Rotation
                            if math.abs(finalRotation - initialRotation) > 5 then
                                progressDetected = true
                                return true
                            end
                        else
                            return true
                        end
                    else
                        return true
                    end
                    
                    interactionAttempts = interactionAttempts + 1
                end
                
                if not progressDetected then
                    pianoRetries = pianoRetries + 1
                    
                    if pianoRetries >= maxPianoRetries then
                        deprioritizedTasks[taskId] = true
                        taskFailCount[taskId] = (taskFailCount[taskId] or 0) + 1
                        return false
                    end
                    
                    if not taskStillExists(taskId) then
                        return true
                    end
                    
                    moveToPosition(targetPos + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5)), 5)
                    task.wait(0.5)
                    
                    if not taskStillExists(taskId) then
                        return true
                    end
                    
                    moveToPosition(targetPos, 10)
                    task.wait(0.5)
                else
                    return true
                end
            end
            
            return false
        end
        
        return false
        
    elseif config.action == "ride" then
        if not taskStillExists(taskId) then return true end
        
        local rideKey = getKeyCodeFromNumber(hotbarSettings.ride)
        fireKey(rideKey)
        task.wait(1)
        
        local startTime = tick()
        local humanoid = getHumanoid()
        local rootPart = getRootPart()
        
        if not humanoid or not rootPart then return false end
        
        local forward = true
        local lastStuckCheck = tick()
        local lastPos = rootPart.Position
        local jumpTimer = tick()
        
        while tick() - startTime < 115 do
            if not taskStillExists(taskId) then
                break
            end
            
            updateTaskQueue()
            
            local stillActive = false
            for _, id in pairs(queueOrder) do
                if id == taskId then
                    stillActive = true
                    break
                end
            end
            
            if not stillActive then
                break
            end
            
            rootPart = getRootPart()
            humanoid = getHumanoid()
            
            if rootPart and humanoid then
                if tick() - jumpTimer > 2 and math.random(1, 4) == 1 then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    jumpTimer = tick()
                end
                
                if isStuck(rootPart, lastPos, lastStuckCheck) then
                    forward = not forward
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    lastStuckCheck = tick()
                end
                
                local lookDirection = rootPart.CFrame.LookVector
                local targetPos
                
                if forward then
                    targetPos = rootPart.Position + (lookDirection * 25)
                else
                    targetPos = rootPart.Position - (lookDirection * 25)
                end
                
                humanoid:MoveTo(targetPos)
                lastPos = rootPart.Position
                lastMovementTime = tick()
            end
            
            task.wait(0.1)
        end
        
        local rideKey = getKeyCodeFromNumber(hotbarSettings.ride)
        fireKey(rideKey)
        task.wait(0.5)
        
        return true
        
    elseif config.action == "walk" then
        if not taskStillExists(taskId) then return true end
        
        local startTime = tick()
        local humanoid = getHumanoid()
        local rootPart = getRootPart()
        
        if not humanoid or not rootPart then return false end
        
        local forward = true
        local lastStuckCheck = tick()
        local lastPos = rootPart.Position
        local jumpTimer = tick()
        
        while tick() - startTime < 115 do
            if not taskStillExists(taskId) then
                break
            end
            
            updateTaskQueue()
            
            local stillActive = false
            for _, id in pairs(queueOrder) do
                if id == taskId then
                    stillActive = true
                    break
                end
            end
            
            if not stillActive then
                break
            end
            
            rootPart = getRootPart()
            humanoid = getHumanoid()
            
            if rootPart and humanoid then
                if tick() - jumpTimer > 2 and math.random(1, 4) == 1 then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    jumpTimer = tick()
                end
                
                if isStuck(rootPart, lastPos, lastStuckCheck) then
                    forward = not forward
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    lastStuckCheck = tick()
                end
                
                local lookDirection = rootPart.CFrame.LookVector
                local targetPos
                
                if forward then
                    targetPos = rootPart.Position + (lookDirection * 25)
                else
                    targetPos = rootPart.Position - (lookDirection * 25)
                end
                
                humanoid:MoveTo(targetPos)
                lastPos = rootPart.Position
                lastMovementTime = tick()
            end
            
            task.wait(0.1)
        end
        
        return true
        
    elseif config.action == "throw" then
        if not taskStillExists(taskId) then return true end
        
        local throwKey = getKeyCodeFromNumber(hotbarSettings.throw)
        fireKey(throwKey)
        task.wait(0.8)
        
        local startTime = tick()
        local lastThrowTime = tick()
        
        while tick() - startTime < 120 do
            if not taskStillExists(taskId) then
                break
            end
            
            updateTaskQueue()
            
            local stillActive = false
            for _, id in pairs(queueOrder) do
                if id == taskId then
                    stillActive = true
                    break
                end
            end
            
            if not stillActive then
                break
            end
            
            if tick() - lastThrowTime >= 4 then
                for i = 1, 3 do
                    if not taskStillExists(taskId) then
                        break
                    end
                    
                    clickScreen()
                    task.wait(0.15)
                end
                
                lastThrowTime = tick()
            end
            
            task.wait(0.2)
        end
        
        fireKey(throwKey)
        task.wait(0.5)
        
        return true
    end
    
    return false
end

