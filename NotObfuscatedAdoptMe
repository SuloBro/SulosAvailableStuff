                    statusLabel.Text = "Processing: " .. config.name
                    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                    statusIndicator.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
                    
                    currentTaskIcon.Image = currentTask
                    currentTaskName.Text = config.name
                    currentStroke.Color = config.color
                    currentLabel.TextColor3 = config.color
                end
