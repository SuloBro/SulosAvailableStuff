local function processTaskLoop()
    while task.wait(0.3) do
        if isProcessing then
            if tick() - taskStartTime > 120 then
                isProcessing = false
                taskFailCount[currentTask] = (taskFailCount[currentTask] or 0) + 1
                if taskFailCount[currentTask] >= 3 then
                    deprioritizedTasks[currentTask] = true
                end
                removeTaskFromQueue(currentTask)
                currentTask = nil
            end
            continue
        end
        
        local taskId = getNextTask()
        
        if taskId then
            isProcessing = true
            currentTask = taskId
            taskStartTime = tick()
            taskRetryCount[taskId] = (taskRetryCount[taskId] or 0) + 1
            
            task.spawn(function()
                local success = false
                pcall(function()
                    success = executeTask(taskId)
                end)
                
                if not success then
                    taskFailCount[taskId] = (taskFailCount[taskId] or 0) + 1
                end
                
                task.wait(2)
                
                local recheckCount = 0
                while recheckCount < 50 do
                    updateTaskQueue()
                    
                    if not taskStillExists(taskId) then
                        break
                    end
                    
                    local stillInQueue = false
                    for _, id in pairs(queueOrder) do
                        if id == taskId then
                            stillInQueue = true
                            break
                        end
                    end
                    
                    if not stillInQueue then
                        break
                    end
                    
                    task.wait(1.5)
                    recheckCount = recheckCount + 1
                end
                
                removeTaskFromQueue(taskId)
                isProcessing = false
                currentTask = nil
            end)
        end
    end
end

local function applyInventoryChanges()
    pcall(function()
