local function PlayShineEffect(button)
    local existingShine = button:FindFirstChild("ShineFrame")
    if existingShine then
        existingShine:Destroy()
    end
    
    local shineFrame = Instance.new("Frame")
    shineFrame.Name = "ShineFrame"
    shineFrame.Size = UDim2.new(0.2, 0, 1.2, 0)
    shineFrame.Position = UDim2.new(-0.2, 0, -0.1, 0)
    shineFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shineFrame.BackgroundTransparency = 0.6
    shineFrame.BorderSizePixel = 0
    shineFrame.Rotation = 20
    shineFrame.ZIndex = 15
    shineFrame.Parent = button
    
    local shineGradient = Instance.new("UIGradient")
    shineGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.3, 0.3),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(0.7, 0.3),
        NumberSequenceKeypoint.new(1, 1)
    })
    shineGradient.Rotation = 90
    shineGradient.Parent = shineFrame
    
    local shineTween = TweenService:Create(shineFrame, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        Position = UDim2.new(1.2, 0, -0.1, 0)
    })
    
    shineTween:Play()
    shineTween.Completed:Connect(function()
        shineFrame:Destroy()
    end)
end

local function TypewriterEffect(textLabel, fullText, duration)
    textLabel.Text = ""
    local chars = {}
    for i = 1, #fullText do
        chars[i] = fullText:sub(i, i)
    end
    local delayPerChar = duration / #chars
    
    for i, char in ipairs(chars) do
        textLabel.Text = textLabel.Text .. char
        task.wait(delayPerChar)
    end
end

