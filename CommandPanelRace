local function PlayShineEffect(button)
    local existingShine = button:FindFirstChild("ShineFrame")
    if existingShine then
        existingShine:Destroy()
    end
    
    local shineFrame = Instance.new("Frame")
    shineFrame.Name = "ShineFrame"
    shineFrame.Size = UDim2.new(0.2, 0, 1.2, 0)
    shineFrame.Position = UDim2.new(-0.2, 0, -0.1, 0)
    shineFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shineFrame.BackgroundTransparency = 0.6
    shineFrame.BorderSizePixel = 0
    shineFrame.Rotation = 20
    shineFrame.ZIndex = 15
    shineFrame.Parent = button
    
    local shineGradient = Instance.new("UIGradient")
    shineGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.3, 0.3),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(0.7, 0.3),
        NumberSequenceKeypoint.new(1, 1)
    })
    shineGradient.Rotation = 90
    shineGradient.Parent = shineFrame
    
    local shineTween = TweenService:Create(shineFrame, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        Position = UDim2.new(1.2, 0, -0.1, 0)
    })
    
    shineTween:Play()
    shineTween.Completed:Connect(function()
        shineFrame:Destroy()
    end)
end

local function TypewriterEffect(textLabel, fullText, duration)
    textLabel.Text = ""
    local chars = {}
    for i = 1, #fullText do
        chars[i] = fullText:sub(i, i)
    end
    local delayPerChar = duration / #chars
    
    for i, char in ipairs(chars) do
        textLabel.Text = textLabel.Text .. char
        task.wait(delayPerChar)
    end
end

local function AnimateButtonsIn()
    stopButton.Visible = true
    resetButton.Visible = true
    
    local stopGradient = stopButton:FindFirstChild("ButtonGradient")
    if stopGradient then
        stopGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 70, 70)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(130, 70, 70)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 70, 70))
        }
    end
    
    local resetGradient = resetButton:FindFirstChild("ButtonGradient")
    if resetGradient then
        resetGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 100, 120)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(70, 70, 90)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 100, 120))
        }
    end
    
    local stopTween = TweenService:Create(stopButton, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, -20, 0, 50)
    })
    
    local resetTween = TweenService:Create(resetButton, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, -20, 0, 40)
    })
    
    stopTween:Play()
    spawn(function()
        TypewriterEffect(stopButton, "Stop Race", 0.3)
    end)
    
    task.wait(0.1)
    resetTween:Play()
    spawn(function()
        TypewriterEffect(resetButton, "Reset Race", 0.3)
    end)
    
    resetTween.Completed:Wait()
    
    PlayShineEffect(stopButton)
    task.wait(0.1)
    PlayShineEffect(resetButton)
end

local function AnimateButtonsOut()
