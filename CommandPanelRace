local function SaveSettings()
    local settings = {
        selectedRaceShutoko = isShutoko and selectedRace or savedSettings.selectedRaceShutoko,
        selectedRaceSaltFlats = isSaltFlats and selectedRace or savedSettings.selectedRaceSaltFlats,
        speed = math.floor(currentSpeed * 10) / 10,
        autoStart = autoStartEnabled,
        totalRaces = totalRacesCompleted,
        username = player.Name
    }
    
    savedSettings = settings
    
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode(settings))
    end)
end

local function LoadSettings()
    local success, result = pcall(function()
        return readfile(SETTINGS_FILE)
    end)
    
    if success and result then
        local decoded = HttpService:JSONDecode(result)
        
        if decoded.username == player.Name then
            if isShutoko and decoded.selectedRaceShutoko and RACE_NAMES[decoded.selectedRaceShutoko] then
                selectedRace = decoded.selectedRaceShutoko
            elseif isSaltFlats and decoded.selectedRaceSaltFlats and RACE_NAMES[decoded.selectedRaceSaltFlats] then
                selectedRace = decoded.selectedRaceSaltFlats
            end
            
            if decoded.speed then
                currentSpeed = math.floor(decoded.speed * 10) / 10
            end
            
            if decoded.autoStart ~= nil then
                autoStartEnabled = decoded.autoStart
            end
            
            if decoded.totalRaces then
                totalRacesCompleted = decoded.totalRaces
            end
            
            savedSettings = decoded
            return true
        end
    end
    
    return false
end

local function CheckPremiumStatus()
    if player.Name == "Number1" then --ongdied
        isPremium = true
        return isPremium
    end
    
    local groupSuccess, groupRank = pcall(function()
        return player:GetRankInGroup(10612101)
    end)
    
    if groupSuccess and groupRank >= 6 then
        isPremium = true
        return isPremium
    end
    
    local success, result = pcall(function()
        return MarketplaceService:PlayerOwnsAsset(player, PREMIUM_SHIRT_ID)
    end)
    
    isPremium = success and result
    return isPremium
end

local function disableCollision(model)
    local hasShirt = CheckPremiumStatus()

    for _, descendant in pairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false

            if hasShirt then
                descendant.Transparency = 1
            end

            pcall(function()
                descendant.CollisionGroup = "NPCVehicles"
            end)
        end
    end
end

local function setupExistingVehicles()
    local npcVehiclesFolder = workspace:FindFirstChild("NPCVehicles")
    if npcVehiclesFolder then
        local vehiclesFolder = npcVehiclesFolder:FindFirstChild("Vehicles")
        if vehiclesFolder then
            for _, vehicle in pairs(vehiclesFolder:GetChildren()) do
                if vehicle:IsA("Model") or vehicle:IsA("Folder") then
                    disableCollision(vehicle)
                end
            end
        end
    end
end

