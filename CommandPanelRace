game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local sliderPos = speedSlider.AbsolutePosition.X
        local sliderSize = speedSlider.AbsoluteSize.X
        local mousePos = input.Position.X
        
        local relativePos = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
        
        local maxSpeed = 24
        local premiumThreshold = 17
        
        if not isPremium and relativePos > ((premiumThreshold - 1) / (maxSpeed - 1)) then
            relativePos = (premiumThreshold - 1) / (maxSpeed - 1)
        end
        
        currentSpeed = 1 + (relativePos * (maxSpeed - 1))
        
        speedFill.Size = UDim2.new(relativePos, 0, 1, 0)
        speedKnob.Position = UDim2.new(relativePos, -8, 0.5, -8)
        
        local speedRounded = math.floor(currentSpeed * 10) / 10
        
        if not isPremium and currentSpeed >= premiumThreshold then
            speedLabel.Text = "Speed: " .. speedRounded .. " (Only premium can go faster)"
            speedLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        elseif currentSpeed > 10 then
            speedLabel.Text = "Speed ( This fast could get you banned ): " .. speedRounded
            speedLabel.TextColor3 = Color3.fromRGB(255, 220, 0)
        else
            speedLabel.Text = "Speed: " .. speedRounded
            speedLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
    end
end)

