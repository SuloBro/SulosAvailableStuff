end

local function TeleportToPosition(position)
    if not carModel or not carPrimary then return end
    
    local targetPos = position + Vector3.new(0, CAR_HEIGHT, 0)
    
    local currentPos = carPrimary.Position
    local direction = (targetPos - currentPos).Unit
    local lookDirection = Vector3.new(direction.X, 0, direction.Z).Unit
    
    if lookDirection.Magnitude > 0 then
        local targetCFrame = CFrame.new(targetPos, targetPos + lookDirection)
        carModel:SetPrimaryPartCFrame(targetCFrame)
    else
        carModel:SetPrimaryPartCFrame(CFrame.new(targetPos))
    end
    
    if carPrimary then
        carPrimary.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        carPrimary.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end

local function MoveCarSmoothly(targetPosition)
    if not carModel or not carPrimary then return end
    
    local currentPos = carPrimary.Position
    local direction = (targetPosition - currentPos).Unit
    local distance = (targetPosition - currentPos).Magnitude
    
    local lookDirection = Vector3.new(direction.X, 0, direction.Z).Unit
    
    if lookDirection.Magnitude > 0 then
        local step = math.min(currentSpeed, distance)
        local newPos = currentPos + (direction * step)
        
        local targetCFrame = CFrame.new(newPos, newPos + lookDirection)
        carModel:SetPrimaryPartCFrame(targetCFrame)
        
        if carPrimary then
            carPrimary.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            carPrimary.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end

local function GetTargetPosition()
    local checkpoint = FindCheckpoint(currentCheckpoint)
    
    if checkpoint then
        return checkpoint.Position
    end
    
    local manualPos = GetManualCheckpointPosition(currentCheckpoint)
    if manualPos then
        return manualPos
    end
    
    return nil
end

local function StopRacing()
    raceActive = false
    finishReached = false
    hasIncrementedRace = false
    
    if checkpointDetectionLoop then
        checkpointDetectionLoop:Disconnect()
        checkpointDetectionLoop = nil
    end
    
    if carPrimary and carPrimary.Parent then
        carPrimary.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        carPrimary.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    
    carModel = nil
    carPrimary = nil
    currentCheckpoint = 1
    checkpointStartTime = 0
    lastCheckpointNumber = 0
end

