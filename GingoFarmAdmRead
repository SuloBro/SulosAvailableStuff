-- Load trial data from storage
local function LoadTrialData()
    pcall(function()
        if not isfolder("AutofarmScript") then
            makefolder("AutofarmScript")
        end
        
        if isfile("AutofarmScript/trial.json") then
            local data = readfile("AutofarmScript/trial.json")
            local decoded = HttpService:JSONDecode(data)
            if decoded and decoded.userId == player.UserId then
                trialData = decoded
                print("📂 Loaded trial data from storage")
            end
        end
    end)
end

-- Save trial data to storage
local function SaveTrialData()
    pcall(function()
        if not isfolder("AutofarmScript") then
            makefolder("AutofarmScript")
        end
        
        trialData.userId = player.UserId
        local encoded = HttpService:JSONEncode(trialData)
        writefile("AutofarmScript/trial.json", encoded)
        print("💾 Saved trial data to storage")
        
        AddToGlobalList()
    end)
end

-- Check if trial is active
local function IsTrialActive()
    if not trialData.used then
        return false
    end
    
    local currentTime = os.time()
    if currentTime < trialData.endTime then
        return true
    end
    
    return false
end

-- Get remaining trial time
local function GetRemainingTime()
    if not IsTrialActive() then
        return 0
    end
    
    local currentTime = os.time()
    return trialData.endTime - currentTime
end

-- Format time for display
local function FormatTime(seconds)
    local minutes = math.floor(seconds / 60)
    local secs = seconds % 60
    return string.format("%d min - %d s", minutes, secs)
end

-- Get all users who have trial data
local function GetAllTrialUsers()
    local users = {}
    pcall(function()
        if not isfolder("AutofarmScript") then
            return
        end
        
        if isfile("AutofarmScript/all_trials.json") then
            local data = readfile("AutofarmScript/all_trials.json")
            local decoded = HttpService:JSONDecode(data)
            users = decoded or {}
        end
    end)
    return users
end

-- Save all trial users
local function SaveAllTrialUsers(users)
    pcall(function()
        if not isfolder("AutofarmScript") then
            makefolder("AutofarmScript")
        end
        
        local encoded = HttpService:JSONEncode(users)
        writefile("AutofarmScript/all_trials.json", encoded)
    end)
end

-- Add current user to global list
local function AddToGlobalList()
    pcall(function()
        local allUsers = GetAllTrialUsers()
        
        local found = false
        for i, userData in ipairs(allUsers) do
            if userData.userId == player.UserId then
                allUsers[i] = {
                    userId = player.UserId,
                    username = player.Name,
                    used = trialData.used,
                    startTime = trialData.startTime,
                    endTime = trialData.endTime
                }
                found = true
                break
            end
        end
        
        if not found then
            table.insert(allUsers, {
                userId = player.UserId,
                username = player.Name,
                used = trialData.used,
                startTime = trialData.startTime,
                endTime = trialData.endTime
            })
        end
        
        SaveAllTrialUsers(allUsers)
    end)
end

