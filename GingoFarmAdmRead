                stars[i].TextColor3 = Color3.fromRGB(255, 200, 100)
                TweenService:Create(stars[i], TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 45, 0, 45)}):Play()
