local function createSparkleExplosion(parent, position)
    for i = 1, 12 do
        local sparkle = Instance.new("ImageLabel")
        sparkle.Size = UDim2.new(0, 20, 0, 20)
        sparkle.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset)
        sparkle.AnchorPoint = Vector2.new(0.5, 0.5)
        sparkle.BackgroundTransparency = 1
        sparkle.Image = "rbxassetid://14888742106"
        sparkle.ImageColor3 = Color3.fromHSV(math.random(), 1, 1)
        sparkle.ZIndex = 1000
        sparkle.Parent = parent
        
        local angle = math.rad((360 / 12) * i)
        local distance = math.random(50, 100)
        local endX = position.X.Offset + math.cos(angle) * distance
        local endY = position.Y.Offset + math.sin(angle) * distance
        
        local moveTween = TweenService:Create(sparkle, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(position.X.Scale, endX, position.Y.Scale, endY),
            ImageTransparency = 1,
            Rotation = math.random(-180, 180)
        })
        
        moveTween:Play()
        
        task.delay(0.6, function()
            sparkle:Destroy()
        end)
    end
end

