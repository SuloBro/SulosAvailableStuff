local function sendWebhook(username, userId, rating)
    local success, err = pcall(function()
        local payload = {
            username = "Autofarm Ratings",
            embeds = {{
                title = "New Rating Received!",
                color = 3447003,
                fields = {
                    {name = "Username", value = username, inline = true},
                    {name = "User ID", value = tostring(userId), inline = true},
                    {name = "Rating", value = rating .. " star" .. (rating > 1 and "s" or ""), inline = false}
                },
                thumbnail = {url = getThumbnail(userId)}
            }}
        }
        local jsonPayload = HttpService:JSONEncode(payload)
        HttpService:PostAsync(WEBHOOK_URL, jsonPayload, Enum.HttpContentType.ApplicationJson)
    end)
end

