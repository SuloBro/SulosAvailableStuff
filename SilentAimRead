-- This method hooks __index directly on Mouse for instant targeting
local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and SilentAimSettings.Enabled then
        if self == Mouse then
            local target = getClosestPlayer()
            
            if target then
                local chance = CalculateChance(SilentAimSettings.HitChance)
                
                if chance then
                    local predictedPos = CalculatePredictedPosition(target)
                    
                    if key == "Hit" then
                        return CFrame.new(predictedPos or target.Position)
                    elseif key == "Target" then
                        return target
                    elseif key == "X" then
                        local pos = Camera:WorldToViewportPoint(predictedPos or target.Position)
                        return pos.X
                    elseif key == "Y" then
                        local pos = Camera:WorldToViewportPoint(predictedPos or target.Position)
                        return pos.Y
                    elseif key == "UnitRay" then
                        local pos = predictedPos or target.Position
                        local origin = Camera.CFrame.Position
                        local direction = (pos - origin).Unit
                        return Ray.new(origin, direction * 1000)
                    end
                end
            end
        end
    end
    
    return oldIndex(self, key)
end))

-- Hook for remote functions/events
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if not checkcaller() and SilentAimSettings.Enabled then
        if (method == "FireServer" or method == "InvokeServer") then
            local chance = CalculateChance(SilentAimSettings.HitChance)
            
            if chance then
                local target = getClosestPlayer()
                
                if target then
                    -- Check if any argument is a CFrame or Position
                    for i, arg in pairs(args) do
                        if typeof(arg) == "CFrame" then
                            local predictedPos = CalculatePredictedPosition(target)
                            args[i] = CFrame.new(predictedPos or target.Position)
                        elseif typeof(arg) == "Vector3" then
                            local predictedPos = CalculatePredictedPosition(target)
                            args[i] = predictedPos or target.Position
                        end
                    end
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end))

-- Additional hook for GetMouseLocation to redirect cursor position
local oldGetMouseLocation
oldGetMouseLocation = hookfunction(UserInputService.GetMouseLocation, function(...)
    if SilentAimSettings.Enabled then
        local target = getClosestPlayer()
        if target then
            local chance = CalculateChance(SilentAimSettings.HitChance)
            if chance then
                local predictedPos = CalculatePredictedPosition(target)
                local screenPos = Camera:WorldToViewportPoint(predictedPos or target.Position)
                return Vector2.new(screenPos.X, screenPos.Y)
            end
        end
    end
    return oldGetMouseLocation(...)
end)

