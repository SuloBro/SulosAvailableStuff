            local predictedPos = CalculatePredictedPosition(target)
            local RootToViewportPoint, IsOnScreen = Camera:WorldToViewportPoint(predictedPos or Root.Position)
            
            mouse_box.Visible = IsOnScreen
            mouse_box.Position = Vector2.new(RootToViewportPoint.X - 10, RootToViewportPoint.Y - 10)
        else 
            mouse_box.Visible = false
        end
    end
    
    if Toggles.Visible.Value then 
        fov_circle.Visible = true
        fov_circle.Position = getMousePosition()
    else
        fov_circle.Visible = false
    end
    
    if HasPremium() then
        UpdateESP()
    end
end)

