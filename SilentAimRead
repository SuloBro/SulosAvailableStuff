-- ================= AUTO PREDICTION SYSTEM =================
local function updateAutoPrediction()
    while task.wait(0.1) do
        if not SilentAimSettings.AutoPrediction then continue end
        if tick() - lastPredictionUpdate < PREDICTION_UPDATE_DELAY then continue end
        lastPredictionUpdate = tick()
        
        local success, pingStr = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        end)
        
        if not success then continue end
        
        local ping = tonumber(string.match(pingStr, "%d+"))
        if not ping then continue end
        
        -- Adjusted prediction values for better accuracy
        if ping < 30 then
            PredictionAmount = 0.138
        elseif ping < 60 then
            PredictionAmount = 0.145
        elseif ping < 90 then
            PredictionAmount = 0.155
        elseif ping < 120 then
            PredictionAmount = 0.165
        elseif ping < 150 then
            PredictionAmount = 0.175
        else
            PredictionAmount = 0.190
        end
        
        SilentAimSettings.PredictionAmount = PredictionAmount
    end
end

task.spawn(updateAutoPrediction)

