local function CreateESP(player)
    if ESPObjects[player] then return end
    
    local ESPData = {
        Box = Drawing.new("Square"),
        HealthBar = Drawing.new("Square"),
        HealthBarOutline = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Tracer = Drawing.new("Line")
    }
    
    ESPData.Box.Thickness = 1
    ESPData.Box.Filled = false
    ESPData.Box.Transparency = 1
    ESPData.Box.ZIndex = 2
    
    ESPData.HealthBarOutline.Thickness = 1
    ESPData.HealthBarOutline.Filled = false
    ESPData.HealthBarOutline.Color = Color3.new(0, 0, 0)
    ESPData.HealthBarOutline.Transparency = 1
    ESPData.HealthBarOutline.ZIndex = 2
    
    ESPData.HealthBar.Thickness = 1
    ESPData.HealthBar.Filled = true
    ESPData.HealthBar.Transparency = 1
    ESPData.HealthBar.ZIndex = 3
    
    ESPData.Name.Center = true
    ESPData.Name.Outline = true
    ESPData.Name.Font = Drawing.Fonts.Plex
    ESPData.Name.Size = 13
    ESPData.Name.Transparency = 1
    ESPData.Name.ZIndex = 3
    
    ESPData.Distance.Center = true
    ESPData.Distance.Outline = true
    ESPData.Distance.Font = Drawing.Fonts.Plex
    ESPData.Distance.Size = 13
    ESPData.Distance.Transparency = 1
    ESPData.Distance.ZIndex = 3
    
    ESPData.Tracer.Thickness = 1
    ESPData.Tracer.Transparency = 1
    ESPData.Tracer.ZIndex = 2
    
    ESPObjects[player] = ESPData
end

local function RemoveESP(player)
    if not ESPObjects[player] then return end
    
    for _, drawing in pairs(ESPObjects[player]) do
        drawing:Remove()
    end
    
    ESPObjects[player] = nil
end

local function UpdateESP()
    if not ESPSettings.Enabled then
        for player, esp in pairs(ESPObjects) do
            for _, drawing in pairs(esp) do
                drawing.Visible = false
            end
        end
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        if not ESPObjects[player] then
            CreateESP(player)
        end
        
        local character = player.Character
        local esp = ESPObjects[player]
        
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            for _, drawing in pairs(esp) do
                drawing.Visible = false
            end
            continue
        end
        
        local rootPart = character.HumanoidRootPart
        local humanoid = character:FindFirstChild("Humanoid")
        local head = character:FindFirstChild("Head")
        
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            for _, drawing in pairs(esp) do
                drawing.Visible = false
            end
            continue
        end
        
        local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
        
        if not onScreen then
            for _, drawing in pairs(esp) do
                drawing.Visible = false
            end
            continue
        end
        
        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
        
        local height = math.abs(headPos.Y - legPos.Y)
        local width = height / 2
        
        local teamColor = Color3.fromRGB(255, 50, 50)
        if ESPSettings.TeamColor and player.Team then
            teamColor = player.Team.TeamColor.Color
        end
        
        esp.Box.Size = Vector2.new(width, height)
        esp.Box.Position = Vector2.new(rootPos.X - width/2, rootPos.Y - height/2)
        esp.Box.Color = teamColor
        esp.Box.Visible = true
        
        if ESPSettings.ShowHealth then
            local healthBarWidth = 3
            local healthBarHeight = height
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            
            esp.HealthBarOutline.Size = Vector2.new(healthBarWidth + 2, healthBarHeight + 2)
            esp.HealthBarOutline.Position = Vector2.new(rootPos.X - width/2 - healthBarWidth - 3, rootPos.Y - height/2 - 1)
            esp.HealthBarOutline.Visible = true
            
            esp.HealthBar.Size = Vector2.new(healthBarWidth, healthBarHeight * healthPercent)
            esp.HealthBar.Position = Vector2.new(rootPos.X - width/2 - healthBarWidth - 2, rootPos.Y - height/2 + (healthBarHeight * (1 - healthPercent)))
            esp.HealthBar.Color = Color3.fromRGB(0, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), 1 - healthPercent)
            esp.HealthBar.Visible = true
        else
            esp.HealthBar.Visible = false
            esp.HealthBarOutline.Visible = false
        end
        
        if ESPSettings.ShowNames then
            esp.Name.Text = player.Name
            esp.Name.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 15)
            esp.Name.Color = teamColor
            esp.Name.Visible = true
        else
            esp.Name.Visible = false
        end
        
        if ESPSettings.ShowDistance then
            local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude)
            esp.Distance.Text = tostring(distance) .. "m"
            esp.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + height/2 + 5)
            esp.Distance.Color = Color3.fromRGB(255, 255, 255)
            esp.Distance.Visible = true
        else
            esp.Distance.Visible = false
        end
        
        esp.Tracer.Visible = false
    end
end

