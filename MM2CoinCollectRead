local function findAllMapsWithCoins()
    local mapsWithCoins = {}
    
    print("Scanning workspace for maps with CoinContainer...")
    
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local coinContainer = obj:FindFirstChild("CoinContainer")
            if coinContainer and coinContainer:IsA("Model") then
                local coinCount = 0
                for _, coin in pairs(coinContainer:GetChildren()) do
                    if coin:IsA("BasePart") and coin.Name == "Coin_Server" then
                        coinCount = coinCount + 1
                    end
                end
                
                if coinCount > 0 then
                    table.insert(mapsWithCoins, {
                        name = obj.Name,
                        model = obj,
                        coinContainer = coinContainer,
                        coinCount = coinCount
                    })
                    print("Found map: " .. obj.Name .. " with " .. coinCount .. " coins")
                end
            end
        end
    end
    
    print("Total maps with coins: " .. #mapsWithCoins)
    return mapsWithCoins
end

local function getCurrentMap()
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local coinContainer = obj:FindFirstChild("CoinContainer")
            if coinContainer and coinContainer:IsA("Model") then
                for _, coin in pairs(coinContainer:GetChildren()) do
                    if coin:IsA("BasePart") and coin.Name == "Coin_Server" then
                        return obj, coinContainer
                    end
                end
            end
        end
    end
    
    return nil, nil
end

local function getAllCoinsFromMap(coinContainer)
    local coins = {}
    
    if not coinContainer then return coins end
    
    local children = coinContainer:GetChildren()
    for i = 1, #children do
        local coin = children[i]
        if coin:IsA("BasePart") and coin.Name == "Coin_Server" then
            coins[#coins + 1] = coin
        end
    end
    
    return coins
end

local function refreshAvailableCoins()
    if not cachedCoinContainer or not cachedCoinContainer.Parent then
        return
    end
    
    local currentTime = tick()
    if currentTime - lastRefreshTime < COIN_REFRESH_RATE then
        return
    end
    
    lastRefreshTime = currentTime
    
    availableCoins = getAllCoinsFromMap(cachedCoinContainer)
    
    print("Coins refreshed: " .. #availableCoins .. " available")
end

local function disableCharacterCollision(character)
    if not character then return end
    
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

