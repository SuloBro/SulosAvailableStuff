local function teleportToSafePosition()
    local character = player.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local safePosition = Vector3.new(-5038, 287, 84)
    humanoidRootPart.CFrame = CFrame.new(safePosition)
    
    print("No coins detected - teleported to safe position")
end

local function teleportToSafePositionSlow()
    local character = player.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local safePosition = Vector3.new(-5038, 287, 84)
    
    local tween = TweenService:Create(
        humanoidRootPart,
        TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        {CFrame = CFrame.new(safePosition)}
    )
    
    tween:Play()
    print("✅ Max coins reached! Slowly moving to safe position...")
    showNotification("50 coins collected! Moving to safe spot...")
    
    return tween
end

local function tweenToCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local character = player.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    local currentPos = humanoidRootPart.Position
    local targetPos = coin.Position
    local distance = (currentPos - targetPos).Magnitude
    local tweenTime = math.clamp(distance / 40, 0.5, 3)
    
    local targetCFrame = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z)
    
    local tween = TweenService:Create(
        humanoidRootPart,
        TweenInfo.new(tweenTime, Enum.EasingStyle.Linear),
        {CFrame = targetCFrame}
    )
    
    tween:Play()
    tween.Completed:Wait()
    
    return true
end

local function getNearestCoin()
    if #availableCoins == 0 then return nil end
    
    local character = player.Character
    if not character then return nil end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return nil end
    
    local nearestCoin = nil
    local shortestDistance = math.huge
    local playerPos = humanoidRootPart.Position
    
    for i = 1, #availableCoins do
        local coin = availableCoins[i]
        if coin and coin.Parent then
            local distance = (playerPos - coin.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestCoin = coin
            end
        end
    end
    
    return nearestCoin
end

local function startAutofarm()
    if isRunning then
        showNotification("Already running!")
        return
    end
    
    isRunning = true
    currentCoinIndex = 1
    lastRefreshTime = 0
    lastCoinIncreaseTime = tick()
    
    local character = player.Character
    if character then
        disableCharacterCollision(character)
        playFarmAnimation(character)
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
        
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Name = "AntiGravity"
            bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = hrp
        end
    end
    
    bodiesConnection = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if char and isRunning then
            disableCharacterCollision(char)
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if hrp then
                if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                end
                
                local currentTime = tick()
                local rotationSpeed = 5
                local rotationAngle = (currentTime * rotationSpeed) % 360
                
                local pos = hrp.Position
                hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(rotationAngle), 0)
                
                local antiGravity = hrp:FindFirstChild("AntiGravity")
                if not antiGravity then
                    antiGravity = Instance.new("BodyVelocity")
                    antiGravity.Name = "AntiGravity"
                    antiGravity.MaxForce = Vector3.new(0, math.huge, 0)
                    antiGravity.Velocity = Vector3.new(0, 0, 0)
                    antiGravity.Parent = hrp
                end
            end
        end
    end)
    
    showNotification("Starting coin collection...")
    
    spawn(function()
        while isRunning do
            refreshAvailableCoins()
            task.wait(COIN_REFRESH_RATE)
        end
    end)
    
    spawn(function()
        while isRunning do
            updateTotalCoins()
            task.wait(0.5)
        end
    end)
    
    -- NEW: Loop to keep character at safe position when no coins
    spawn(function()
        while isRunning do
            if hasReachedMaxCoins or #availableCoins == 0 then
                local character = player.Character
                if character then
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local safePosition = Vector3.new(-5038, 287, 84)
                        local distance = (hrp.Position - safePosition).Magnitude
                        
                        -- If drifted more than 20 studs away, TP back
                        if distance > 20 then
                            hrp.CFrame = CFrame.new(safePosition)
                            print("Character drifted away, teleporting back to safe position")
                        end
                    end
                end
            end
            task.wait(3) -- Check every 3 seconds
        end
    end)
    
    spawn(function()
        while isRunning do
            local character = player.Character
            if not character then
                task.wait(1)
                continue
            end
            
            if hasReachedMaxCoins then
                teleportToSafePositionSlow()
                while hasReachedMaxCoins and isRunning do
                    task.wait(1)
                end
                continue
            end
            
            local mapModel, coinContainer = getCurrentMap()
            
            if not mapModel or not coinContainer then
                teleportToSafePosition()
                task.wait(2)
                continue
            end
            
            if currentMap ~= mapModel or cachedCoinContainer ~= coinContainer then
                currentMap = mapModel
                cachedCoinContainer = coinContainer
                availableCoins = getAllCoinsFromMap(coinContainer)
                currentCoinIndex = 1
                lastRefreshTime = 0
                print("Map changed to: " .. mapModel.Name)
            end
            
            if #availableCoins == 0 then
                teleportToSafePosition()
                task.wait(2)
                continue
            end
            
            if avoidMurdererEnabled and not playerHasKnife() then
                murdererPlayer = findMurderer()
                if murdererPlayer and murdererPlayer.Character then
                    local murdererHRP = murdererPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local ourHRP = character:FindFirstChild("HumanoidRootPart")
                    
                    if murdererHRP and ourHRP then
                        local distance = (ourHRP.Position - murdererHRP.Position).Magnitude
                        
                        if distance < 50 then
                            local safePos = getSafePositionFromMurderer()
                            if safePos then
                                ourHRP.CFrame = CFrame.new(safePos)
                                print("⚠️ DANGER! Murderer close - escaping...")
                                showNotification("⚠️ Murderer nearby! Escaping...")
                                task.wait(2)
                                continue
                            end
                        end
                    end
                end
            end
            
            local nearestCoin = getNearestCoin()
            
            if nearestCoin and nearestCoin.Parent then
                if tweenToCoin(nearestCoin) then
                    local character = player.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    
                    if hrp and nearestCoin and nearestCoin.Parent then
                        local coinPos = nearestCoin.Position
                        local startTime = tick()
                        local circleDuration = 0.5
                        
                        while tick() - startTime < circleDuration and nearestCoin.Parent do
                            local progress = (tick() - startTime) / circleDuration
                            local angle = progress * math.pi * 2
                            local radius = 3
                            
                            local offsetX = math.cos(angle) * radius
                            local offsetZ = math.sin(angle) * radius
                            
                            hrp.CFrame = CFrame.new(coinPos.X + offsetX, coinPos.Y, coinPos.Z + offsetZ) * CFrame.Angles(0, math.rad(progress * 360), 0)
                            
                            task.wait()
                        end
                    end
                    
                    task.wait(math.max(0, TELEPORT_DELAY - 0.5))
                end
            else
                teleportToSafePosition()
                task.wait(1)
            end
            
            task.wait(0.1)
        end
    end)
end

local function stopAutofarm()
    isRunning = false
    
    stopFarmAnimation()
    
    if coinRefreshConnection then
        coinRefreshConnection:Disconnect()
        coinRefreshConnection = nil
    end
    
    if bodiesConnection then
        bodiesConnection:Disconnect()
        bodiesConnection = nil
    end
    
    if connection then
        connection:Disconnect()
        connection = nil
    end
    
    local character = player.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position)
            
            local antiGravity = humanoidRootPart:FindFirstChild("AntiGravity")
            if antiGravity then
                antiGravity:Destroy()
            end
        end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
    
    availableCoins = {}
    currentCoinIndex = 1
    currentMap = nil
    cachedCoinContainer = nil
    lastRefreshTime = 0
    totalCoinsCollected = 0
    lastCoinCount = 0
    coinGuiPath = nil
    lastCoinIncreaseTime = 0
    noIncreaseTimer = 0
    hasReachedMaxCoins = false
    
    showNotification("Stopped coin collection")
