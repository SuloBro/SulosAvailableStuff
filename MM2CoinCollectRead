        local lockIcon = Instance.new("TextLabel")
        lockIcon.Size = UDim2.new(1, 0, 1, 0)
        lockIcon.BackgroundTransparency = 1
        lockIcon.Font = Enum.Font.FredokaOne
        lockIcon.Text = "🔒 PREMIUM"
        lockIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
        lockIcon.TextSize = 16
        lockIcon.ZIndex = 11
        lockIcon.Parent = lockOverlay
    else
        local isAdjustingSpeed = false
        
        speedSliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isAdjustingSpeed = true
                isDragging = false
            end
        end)
        
        speedSliderBg.InputChanged:Connect(function(input)
            if isAdjustingSpeed and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local mousePos = input.Position.X
                local sliderPos = speedSliderBg.AbsolutePosition.X
                local sliderSize = speedSliderBg.AbsoluteSize.X
                
                local relativeX = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
                
                speedHandle.Position = UDim2.new(relativeX, 0, 0.5, 0)
                speedFill.Size = UDim2.new(relativeX, 0, 1, 0)
                
                TELEPORT_DELAY = 1.0 + (relativeX * 2.0)
                speedValueLabel.Text = string.format("%.1fs", TELEPORT_DELAY)
            end
        end)
        
        speedSliderBg.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isAdjustingSpeed = false
            end
        end)
    end
    
    local toggleButton = Instance.new("TextButton")
    toggleButton.Position = UDim2.new(0, 20, 0, 400)
    toggleButton.Size = UDim2.new(1, -40, 0, 45)
    toggleButton.BackgroundColor3 = Color3.fromRGB(79, 179, 235)
    toggleButton.BorderSizePixel = 0
    toggleButton.AutoButtonColor = false
    toggleButton.Font = Enum.Font.FredokaOne
    toggleButton.Text = "Start Farming"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextSize = 18
    toggleButton.Parent = mainFrame
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 12)
    toggleCorner.Parent = toggleButton
    
    toggleButton.MouseEnter:Connect(function()
        if not isDragging then
            TweenService:Create(toggleButton, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                Position = UDim2.new(0, 20, 0, 395),
                Size = UDim2.new(1, -35, 0, 45)
            }):Play()
        end
    end)
    
    toggleButton.MouseLeave:Connect(function()
        if not isDragging then
            TweenService:Create(toggleButton, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                Position = UDim2.new(0, 20, 0, 400),
                Size = UDim2.new(1, -40, 0, 45)
            }):Play()
        end
    end)
    
    toggleButton.MouseButton1Down:Connect(function()
        TweenService:Create(toggleButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, -42, 0, 43)
        }):Play()
    end)
    
    toggleButton.MouseButton1Up:Connect(function()
        TweenService:Create(toggleButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, -35, 0, 45)
        }):Play()
    end)
    
    local coinsClaimed = 0
    
    toggleButton.MouseButton1Click:Connect(function()
        playSound(6895079853)
        
        if isRunning then
            stopAutofarm()
            toggleButton.Text = "Start Farming"
            toggleButton.BackgroundColor3 = Color3.fromRGB(79, 179, 235)
            statusLabel.Text = "Ready to start"
            statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            statusIndicator.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
        else
            startAutofarm()
            toggleButton.Text = "Stop Farming"
            toggleButton.BackgroundColor3 = Color3.fromRGB(235, 87, 87)
            statusLabel.Text = "Collecting coins..."
            statusLabel.TextColor3 = Color3.fromRGB(79, 179, 235)
            statusIndicator.BackgroundColor3 = Color3.fromRGB(79, 179, 235)
            coinsClaimed = 0
        end
    end)
    
    spawn(function()
        while gui.Parent do
            if isRunning and cachedCoinContainer then
                local totalCollected = updateTotalCoins()
                
                coinsLoadedLabel.Text = "Coins Available: " .. #availableCoins
                coinsClaimedLabel.Text = "Total Collected: " .. totalCollected
                timerLabel.Text = getTimerDisplay()
                
                murdererPlayer = findMurderer()
                if murdererPlayer then
                    murdererImage.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. murdererPlayer.UserId .. "&width=48&height=48&format=png"
                    if murdererPlayer == player then
                        murdererName.Text = murdererPlayer.Name .. " (you)"
                    else
                        murdererName.Text = murdererPlayer.Name
                    end
                    murdererIcon.Visible = true
                else
                    murdererImage.Image = ""
                    murdererName.Text = "No Murderer"
                    murdererIcon.Visible = false
                end
                
                sheriffPlayer = findSheriff()
                if sheriffPlayer then
                    sheriffImage.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. sheriffPlayer.UserId .. "&width=48&height=48&format=png"
                    if sheriffPlayer == player then
                        sheriffName.Text = sheriffPlayer.Name .. " (you)"
                    else
                        sheriffName.Text = sheriffPlayer.Name
                    end
                    sheriffIcon.Visible = true
                else
                    sheriffImage.Image = ""
                    sheriffName.Text = "No Sheriff"
                    sheriffIcon.Visible = false
                end
            end
            task.wait(0.5)
        end
    end)
    
    print("UI Created successfully!")
    return gui, mainFrame, statusLabel, toggleButton, statusIndicator
end

