local function findAllMapsWithCoins()
    local mapsWithCoins = {}
    
    print("Scanning workspace for maps with CoinContainer...")
    
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local coinContainer = obj:FindFirstChild("CoinContainer")
            if coinContainer and coinContainer:IsA("Model") then
                local coinCount = 0
                for _, coin in pairs(coinContainer:GetChildren()) do
                    if coin:IsA("BasePart") and coin.Name == "Coin_Server" then
                        coinCount = coinCount + 1
                    end
                end
                
                if coinCount > 0 then
                    table.insert(mapsWithCoins, {
                        name = obj.Name,
                        model = obj,
                        coinContainer = coinContainer,
                        coinCount = coinCount
                    })
                    print("Found map: " .. obj.Name .. " with " .. coinCount .. " coins")
                end
            end
        end
    end
    
    print("Total maps with coins: " .. #mapsWithCoins)
    return mapsWithCoins
end

local function getCurrentMap()
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local coinContainer = obj:FindFirstChild("CoinContainer")
            if coinContainer and coinContainer:IsA("Model") then
                for _, coin in pairs(coinContainer:GetChildren()) do
                    if coin:IsA("BasePart") and coin.Name == "Coin_Server" then
                        return obj, coinContainer
                    end
                end
            end
        end
    end
    
    return nil, nil
end

local function getAllCoinsFromMap(coinContainer)
    local coins = {}
    
    if not coinContainer then return coins end
    
    for _, coin in pairs(coinContainer:GetChildren()) do
        if coin:IsA("BasePart") and coin.Name == "Coin_Server" then
            table.insert(coins, coin)
        end
    end
    
    print("Found " .. #coins .. " coins in current map")
    return coins
end

