-- IMPROVED: Tween to coin at its actual position
local function tweenToCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local character = player.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    isTweening = true
    
    -- Calculate distance and tween time
    local currentPos = humanoidRootPart.Position
    local targetPos = coin.Position
    local distance = (currentPos - targetPos).Magnitude
    local tweenTime = math.clamp(distance / 40, 0.5, 3)
    
    -- Go to the coin's actual position (including Y)
    local targetCFrame = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z)
    
    -- Create and play tween
    local tween = TweenService:Create(
        humanoidRootPart,
        TweenInfo.new(tweenTime, Enum.EasingStyle.Linear),
        {CFrame = targetCFrame}
    )
    
    tween:Play()
    tween.Completed:Wait()
    
    isTweening = false
    
    return true
end

local function getNearestCoin()
    if #availableCoins == 0 then return nil end
    
    local character = player.Character
    if not character then return nil end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return nil end
    
    local nearestCoin = nil
    local shortestDistance = math.huge
    
    for i, coin in ipairs(availableCoins) do
        if coin and coin.Parent then
            local distance = (humanoidRootPart.Position - coin.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestCoin = coin
            end
        end
    end
    
    return nearestCoin
end

local function removeCollectedCoins()
    local validCoins = {}
    
    for i, coin in ipairs(availableCoins) do
        if coin and coin.Parent then
            table.insert(validCoins, coin)
        end
    end
    
    availableCoins = validCoins
end

local function startAutofarm()
    if isRunning then
        showNotification("Already running!")
        return
    end
    
    isRunning = true
    currentCoinIndex = 1
    
    local character = player.Character
    if character then
        -- Disable collision on all parts
        disableCharacterCollision(character)
        
        -- Play farm animation
        playFarmAnimation(character)
        
        -- Set humanoid to physics state
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
        
        -- Add anti-gravity to prevent falling
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Name = "AntiGravity"
            bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = hrp
        end
    end
    
    -- Simple Heartbeat - maintain rotation, anti-gravity, and prevent random floating
    bodiesConnection = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if char and isRunning then
            disableCharacterCollision(char)
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if hrp then
                -- Keep humanoid in physics state
                if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                end
                
                -- Only lock position when NOT tweening to prevent random floating
                if not isTweening then
                    local currentPos = hrp.Position
                    hrp.Position = currentPos -- Lock in place
                end
                
                -- Constantly rotate character on Y-axis (spinning) to trigger coin collection
                local currentTime = tick()
                local rotationSpeed = 5 -- Rotation speed
                local rotationAngle = (currentTime * rotationSpeed) % 360
                
                local pos = hrp.Position
                hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(rotationAngle), 0)
                
                -- Ensure anti-gravity exists
                local antiGravity = hrp:FindFirstChild("AntiGravity")
                if not antiGravity then
                    antiGravity = Instance.new("BodyVelocity")
                    antiGravity.Name = "AntiGravity"
                    antiGravity.MaxForce = Vector3.new(0, math.huge, 0)
                    antiGravity.Velocity = Vector3.new(0, 0, 0)
                    antiGravity.Parent = hrp
                end
            end
        end
    end)
    
    -- NEW: Auto-refresh coins every 5 seconds
    coinRefreshConnection = RunService.Heartbeat:Connect(function()
        if isRunning then
            task.spawn(function()
                while isRunning do
                    task.wait(5)
                    
                    -- Check if coin bag is full
                    if isCoinBagFull() then
                        print("Coin bag full - teleporting to safe position")
                        teleportToSafePosition()
                        task.wait(2)
                        continue
                    end
                    
                    local mapModel, coinContainer = getCurrentMap()
                    if mapModel and coinContainer then
                        availableCoins = getAllCoinsFromMap(coinContainer)
                        print("Auto-refreshed coins: " .. #availableCoins .. " coins found")
                    end
                end
            end)
            
            -- Disconnect after starting the loop
            if coinRefreshConnection then
                coinRefreshConnection:Disconnect()
                coinRefreshConnection = nil
            end
        end
    end)
    
    showNotification("Starting coin collection...")
    
    spawn(function()
        while isRunning do
            local character = player.Character
            if not character then
                task.wait(1)
                continue
            end
            
            local mapModel, coinContainer = getCurrentMap()
            
            if not mapModel or not coinContainer then
                -- No map detected, go to safe position
                teleportToSafePosition()
                task.wait(2)
                continue
            end
            
            if currentMap ~= mapModel then
                currentMap = mapModel
                availableCoins = getAllCoinsFromMap(coinContainer)
                currentCoinIndex = 1
                print("Map changed to: " .. mapModel.Name)
            end
            
            if #availableCoins == 0 then
                availableCoins = getAllCoinsFromMap(coinContainer)
                currentCoinIndex = 1
            end
            
            if #availableCoins == 0 then
                -- No coins available, teleport to safe position
                teleportToSafePosition()
                task.wait(2)
                continue
            end
            
            removeCollectedCoins()
            
            -- Always go to nearest coin
            local nearestCoin = getNearestCoin()
            
            if nearestCoin and nearestCoin.Parent then
                -- Check if coin bag is full before collecting
                if isCoinBagFull() then
                    print("Coin bag full - going to safe position")
                    teleportToSafePosition()
                    task.wait(2)
                else
                    if tweenToCoin(nearestCoin) then
                        -- Move around the coin in a small circle to ensure collection
                        local character = player.Character
                        local hrp = character and character:FindFirstChild("HumanoidRootPart")
                        
                        if hrp and nearestCoin and nearestCoin.Parent then
                            local coinPos = nearestCoin.Position
                            local startTime = tick()
                            local circleDuration = 0.5 -- Half second to circle around coin
                            
                            isTweening = true
                            
                            -- Make small circular movements around the coin
                            while tick() - startTime < circleDuration and nearestCoin.Parent do
                                local progress = (tick() - startTime) / circleDuration
                                local angle = progress * math.pi * 2 -- Full circle
                                local radius = 3 -- Small radius around coin
                                
                                local offsetX = math.cos(angle) * radius
                                local offsetZ = math.sin(angle) * radius
                                
                                -- Use coin's actual Y position
                                hrp.CFrame = CFrame.new(coinPos.X + offsetX, coinPos.Y, coinPos.Z + offsetZ) * CFrame.Angles(0, math.rad(progress * 360), 0)
                                
                                task.wait()
                            end
                            
                            isTweening = false
                        end
                        
                        -- Stay at coin position for remaining delay time
                        task.wait(math.max(0, TELEPORT_DELAY - 0.5))
                        
                        if gui and gui.Parent then
                            pcall(function()
                                local totalCoins = #getAllCoinsFromMap(coinContainer)
                                local remaining = #availableCoins
                                local claimed = totalCoins - remaining
                                
                                gui:FindFirstChild("CoinAutoFarmFrame"):FindFirstChild("StatusFrame"):FindFirstChild("CoinsLoadedLabel").Text = "Coins Loaded: " .. totalCoins
                                gui:FindFirstChild("CoinAutoFarmFrame"):FindFirstChild("StatusFrame"):FindFirstChild("CoinsClaimedLabel").Text = "Coins Claimed: " .. claimed
                            end)
                        end
                    end
                end
            else
                -- No valid coin, go to safe position
                teleportToSafePosition()
                task.wait(1)
                availableCoins = getAllCoinsFromMap(coinContainer)
            end
            
            task.wait(0.3)
        end
    end)
end

local function stopAutofarm()
    isRunning = false
    isTweening = false
    
    -- Stop animation
    stopFarmAnimation()
    
    -- Disconnect bodies connection
    if bodiesConnection then
        bodiesConnection:Disconnect()
        bodiesConnection = nil
    end
    
    -- Disconnect coin refresh connection
    if coinRefreshConnection then
        coinRefreshConnection:Disconnect()
        coinRefreshConnection = nil
    end
    
    if connection then
        connection:Disconnect()
        connection = nil
    end
    
    local character = player.Character
    if character then
        -- Re-enable collision
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
        
        -- Reset rotation to normal
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position)
            
            -- Remove anti-gravity
            local antiGravity = humanoidRootPart:FindFirstChild("AntiGravity")
            if antiGravity then
                antiGravity:Destroy()
            end
        end
        
        -- Reset humanoid state
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
    
    availableCoins = {}
    currentCoinIndex = 1
    currentMap = nil
    
    showNotification("Stopped coin collection")
end

