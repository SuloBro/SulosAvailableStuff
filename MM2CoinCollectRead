local function getSafePositionFromMurderer()
    if not murdererPlayer or not murdererPlayer.Character then
        return nil
    end
    
    local murdererHRP = murdererPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not murdererHRP then
        return nil
    end
    
    local character = player.Character
    if not character then
        return nil
    end
    
    local ourHRP = character:FindFirstChild("HumanoidRootPart")
    if not ourHRP then
        return nil
    end
    
    local directionAway = (ourHRP.Position - murdererHRP.Position).Unit
    local safeDistance = 100
    local safePosition = murdererHRP.Position + (directionAway * safeDistance)
    
    return safePosition
end

local function ownsShirt(userId, shirtId)
    local success, hasShirt = pcall(function()
        local humanoidDescription = Players:GetHumanoidDescriptionFromUserId(userId)
        
        if humanoidDescription.Shirt == shirtId then
            return true
        end
        
        local character = player.Character
        if character then
            for _, item in pairs(character:GetDescendants()) do
                if item:IsA("Shirt") then
                    local assetId = tonumber(string.match(tostring(item.ShirtTemplate), "%d+"))
                    if assetId == shirtId then
                        return true
                    end
                end
            end
        end
        
        local owns = MarketplaceService:PlayerOwnsAsset(player, shirtId)
        if owns then
            return true
        end
        
        return false
    end)
    
    if success then
        print("Premium check result: " .. tostring(hasShirt))
        return hasShirt
    else
        print("Premium check failed, defaulting to false")
        return false
    end
end

