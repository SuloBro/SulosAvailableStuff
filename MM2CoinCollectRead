local function LoadTrialData()
    pcall(function()
        if not isfolder("CoinAutofarm") then
            makefolder("CoinAutofarm")
        end
        
        local userFile = "CoinAutofarm/trial_" .. player.UserId .. ".json"
        if isfile(userFile) then
            local data = readfile(userFile)
            local decoded = HttpService:JSONDecode(data)
            if decoded and decoded.userId == player.UserId then
                trialData = decoded
                print("Loaded trial data from user file")
                return
            end
        end
        
        print("No existing trial data found for user " .. player.UserId)
    end)
end

local function SaveTrialData()
    pcall(function()
        if not isfolder("CoinAutofarm") then
            makefolder("CoinAutofarm")
        end
        
        trialData.userId = player.UserId
        local encoded = HttpService:JSONEncode(trialData)
        writefile("CoinAutofarm/trial_" .. player.UserId .. ".json", encoded)
        print("Saved trial data for user " .. player.UserId)
    end)
end

local function IsTrialActive()
    if not trialData.used then
        return false
    end
    
    local currentTime = os.time()
    if currentTime < trialData.endTime then
        return true
    end
    
    return false
end

local function GetRemainingTime()
    if not IsTrialActive() then
        return 0
    end
    
    local currentTime = os.time()
    return trialData.endTime - currentTime
end

local function FormatTime(seconds)
    local minutes = math.floor(seconds / 60)
    local secs = seconds % 60
    return string.format("%d min - %d s", minutes, secs)
end

local function ownsShirt(userId, shirtId)
    local success, hasShirt = pcall(function()
        local humanoidDescription = Players:GetHumanoidDescriptionFromUserId(userId)
        
        if humanoidDescription.Shirt == shirtId then
            return true
        end
        
        local character = player.Character
        if character then
            for _, item in pairs(character:GetDescendants()) do
                if item:IsA("Shirt") then
                    local assetId = tonumber(string.match(tostring(item.ShirtTemplate), "%d+"))
                    if assetId == shirtId then
                        return true
                    end
                end
            end
        end
        
        local owns = MarketplaceService:PlayerOwnsAsset(player, shirtId)
        if owns then
            return true
        end
        
        return false
    end)
    
    if success then
        print("Premium check result: " .. tostring(hasShirt))
        return hasShirt
    else
        print("Premium check failed, defaulting to false")
        return false
    end
end

