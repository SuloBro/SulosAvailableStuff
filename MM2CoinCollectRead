local function updateTotalCoins()
    local currentCoins = getCurrentCoinsFromGui()
    
    if currentCoins > lastCoinCount then
        lastCoinIncreaseTime = tick()
        noIncreaseTimer = 0
        hasReachedMaxCoins = false
    else
        noIncreaseTimer = tick() - lastCoinIncreaseTime
    end
    
    if noIncreaseTimer >= 60 and currentCoins > 0 and not hasReachedMaxCoins then
        savedTotalCoins = savedTotalCoins + currentCoins
        hasReachedMaxCoins = true
        print("🎯 Round complete! Saved " .. currentCoins .. " coins. Total saved: " .. savedTotalCoins)
    end
    
    if currentCoins < 5 and lastCoinCount >= 45 and not hasReachedMaxCoins then
        savedTotalCoins = savedTotalCoins + lastCoinCount
        hasReachedMaxCoins = false
        print("🔄 Round reset detected! Saved " .. lastCoinCount .. " coins. Total: " .. savedTotalCoins)
    end
    
    if currentCoins < lastCoinCount and lastCoinCount >= 45 then
        hasReachedMaxCoins = false
    end
    
    lastCoinCount = currentCoins
    
    return savedTotalCoins + currentCoins
end

local function getTimerDisplay()
    if noIncreaseTimer < 60 then
        return string.format("%ds", math.floor(60 - noIncreaseTimer))
    else
        return "0s"
    end
end

